@using BuyingTool.Services
@using System.Linq
@using System.Data;
@{
    Service service = new Service();

    string selectedStoreGrades = string.Empty;
    string selectedSizes = string.Empty;
    string errorMessage = string.Empty;

    if (Session["StoreGrade"] != null && Session["Size"] != null)
    {
        selectedStoreGrades = Session["StoreGrade"] as string;
        selectedSizes = Session["Size"] as string;
    }

    DataTable dataSet = service.GetFinalDataSetFilterCache().GetAwaiter().GetResult();

    var tableNameList = new string[] { "Store Grade (Cummulative)", "Distribution Plan per Store Grade", "Territory (Cummulative)",
                                        "Distribution Plan per Territory", "Distribution Plan per Drops"};

    var selectedTable = string.Empty;

    var storeGradeList = dataSet != null
                ? dataSet.AsEnumerable()
                           .Select(row => row.Field<string>("StoreGrade"))
                           .Where(val => !string.IsNullOrWhiteSpace(val))
                           .Distinct()
                           .ToList()
                : new List<string>();

    var sizeList = dataSet != null
                ? dataSet.AsEnumerable()
                           .Select(row => row.Field<string>("Size"))
                           .Where(val => !string.IsNullOrWhiteSpace(val))
                           .Distinct()
                           .ToList()
                : new List<string>();

    var (tables, dbResponse) = service.GetDistributionSummary(selectedSizes, selectedStoreGrades).GetAwaiter().GetResult();

    // Safely extract all 5 tables from the array
    DataTable table1 = tables != null && tables.Length > 0 ? tables[0] : null; // Store Grade Cumulative
    DataTable table2 = tables != null && tables.Length > 1 ? tables[1] : null; // Territory Cumulative
    DataTable table3 = tables != null && tables.Length > 2 ? tables[2] : null; // Distribution Plan per Store Grade
    DataTable table4 = tables != null && tables.Length > 3 ? tables[3] : null; // Distribution Plan per Territory
    DataTable table5 = tables != null && tables.Length > 4 ? tables[4] : null; // Distribution Plan per Drop

    var tableHeaders1 = new List<string>(); var tableRows1 = new List<string[]>();
    if (table1 != null)
    {
        (tableHeaders1, tableRows1) = service.DatatableConvertToHT(table1).GetAwaiter().GetResult();
    }

    var tableHeaders2 = new List<string>(); var tableRows2 = new List<string[]>();
    if (table2 != null)
    {
        (tableHeaders2, tableRows2) = service.DatatableConvertToHT(table2).GetAwaiter().GetResult();
    }

    var tableHeaders3 = new List<string>(); var tableRows3 = new List<string[]>();
    if (table3 != null)
    {
        (tableHeaders3, tableRows3) = service.DatatableConvertToHT(table3).GetAwaiter().GetResult();
    }

    var tableHeaders4 = new List<string>(); var tableRows4 = new List<string[]>();
    if (table4 != null)
    {
        (tableHeaders4, tableRows4) = service.DatatableConvertToHT(table4).GetAwaiter().GetResult();
    }

    var tableHeaders5 = new List<string>(); var tableRows5 = new List<string[]>();
    if (table5 != null)
    {
        (tableHeaders5, tableRows5) = service.DatatableConvertToHT(table5).GetAwaiter().GetResult();
    }

    <!--if (IsPost && !string.IsNullOrEmpty(Request["actionButton"]))
