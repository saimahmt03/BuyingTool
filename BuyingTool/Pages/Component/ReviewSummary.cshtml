            {

                var tableHeaders = new List<string>();
                var tableRows = new List<string[]>();

                // Tables
                // Store Grade (Cummulative):           tableHeaders1, tableRows1
                // Distribution Plan per Store Grade:   tableHeaders3, tableRows3
                // Territory (Cummulative):             tableHeaders2, tableRows2
                // Distribution Plan per Territory:     tableHeaders4, tableRows4
                // Distribution Plan per Drops:         tableHeaders5, tableRows5

                selectedTable = Request.Form["Table"];

                string userInputFileName = Request.Form["customFileName"];
                string fileName = string.IsNullOrWhiteSpace(userInputFileName) ? "report_summary" : userInputFileName.Trim();

