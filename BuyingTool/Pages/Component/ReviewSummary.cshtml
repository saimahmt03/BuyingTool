                DataTable table6 = tbls != null && tbls.Length > 0 ? tbls[0] : null; // Store Grade Cumulative
                DataTable table7 = tbls != null && tbls.Length > 1 ? tbls[1] : null; // Territory Cumulative
                DataTable table8 = tbls != null && tbls.Length > 2 ? tbls[2] : null; // Distribution Plan per Store Grade
                DataTable table9 = tbls != null && tbls.Length > 3 ? tbls[3] : null; // Distribution Plan per Territory
                DataTable table10 = tbls != null && tbls.Length > 4 ? tbls[4] : null; // Distribution Plan per Drop

                if (table6 != null)
                {
                    (tHeader1, tRows1) = service.DatatableConvertToHT(table6).GetAwaiter().GetResult();

                    tableHeaders1 = tHeader1;
                    tableRows1 = tRows1;
                }

                if (table7 != null)
                {
                    (tHeader2, tRows2) = service.DatatableConvertToHT(table7).GetAwaiter().GetResult();

                    tableHeaders2 = tHeader2;
                    tableRows2 = tRows2;
                }

