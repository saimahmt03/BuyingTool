@using System.Data;
@using BuyingTool.Services
@using System.Linq;
@{
    Service service = new Service();

    var tableHeaders = new List<string>();
    var tableRows = new List<string[]>();
    string errorMessage = string.Empty;
    //bool justCalculated = false;

    DataTable FiltersAttributeDataSet = service.GetFiltersAttributeCache(Session["idnumber"] as string).GetAwaiter().GetResult();
    DataTable FiltersOrganizationDataSet = service.GetFiltersOrganizationCache(Session["idnumber"] as string).GetAwaiter().GetResult();
    DataTable FiltersRequiredDataSet = service.GetFiltersRequiredCache(Session["idnumber"] as string).GetAwaiter().GetResult();
    DataTable FiltersStyleDataSet = service.GetFiltersStylesCache(Session["idnumber"] as string).GetAwaiter().GetResult();

    DataTable dataSet = service.GetFiltersWindow(Session["idnumber"] as string, Session["password"] as string).GetAwaiter().GetResult();

    // Require filter
    var brandList = dataSet != null
                    ? dataSet.AsEnumerable()
                             .Select(row => row.Field<string>("Brand"))
                             .Where(val => !string.IsNullOrWhiteSpace(val))
                             .Distinct()
                             .ToList()
                    : new List<string>();

    var divisionList = dataSet != null
                    ? dataSet.AsEnumerable()
                             .Select(row => row.Field<string>("Division"))
                             .Where(val => !string.IsNullOrWhiteSpace(val))
                             .Distinct()
                             .ToList()
                    : new List<string>();

    var departmentList = dataSet != null
                    ? dataSet.AsEnumerable()
                             .Select(row => row.Field<string>("Department"))
                             .Where(val => !string.IsNullOrWhiteSpace(val))
                             .Distinct()
                             .ToList()
                    : new List<string>();

    var categoryList = dataSet != null
                    ? dataSet.AsEnumerable()
                             .Select(row => row.Field<string>("Category"))
                             .Where(val => !string.IsNullOrWhiteSpace(val))
                             .Distinct()
                             .ToList()
                    : new List<string>();

    var periodPlanList = service.GetPeriodPlan()
                               .GetAwaiter()
                               .GetResult()
                               .AsEnumerable()
                               .Select(row => row.Field<string>("PlanPeriod"))
                               .ToList();

    var collectionList = dataSet != null
                     ? dataSet.AsEnumerable()
                              .Select(row => row.Field<string>("Collection_Age"))
                              .Where(val => !string.IsNullOrWhiteSpace(val))
                              .Distinct()
                              .ToList()
                     : new List<string>();

    // Style
    var styleCodeList = dataSet != null
                    ? dataSet.AsEnumerable()
                               .Select(row => row.Field<string>("Style_Code")) // Adjust column name if needed (e.g., "Style Code")
                               .Where(val => !string.IsNullOrWhiteSpace(val))
                               .Distinct()
                               .ToList()
                    : new List<string>();

    var styleList = dataSet != null
                    ? dataSet.AsEnumerable()
                               .Select(row => row.Field<string>("Style")) // Adjust column name if needed
                               .Where(val => !string.IsNullOrWhiteSpace(val))
                               .Distinct()
                               .OrderBy(val => int.TryParse(val, out int num) ? num : int.MaxValue) // Sorts numerically
                               .ToList()
                    : new List<string>();

    // Organization
    var regionList = dataSet != null
                ? dataSet.AsEnumerable()
                           .Select(row => row.Field<string>("Region"))
                           .Where(val => !string.IsNullOrWhiteSpace(val))
                           .Distinct()
                           .ToList()
                : new List<string>();

    var countryList = dataSet != null
                ? dataSet.AsEnumerable()
                           .Select(row => row.Field<string>("Country"))
                           .Where(val => !string.IsNullOrWhiteSpace(val))
                           .Distinct()
                           .ToList()
                : new List<string>();

    var channelList = dataSet != null
                ? dataSet.AsEnumerable()
                           .Select(row => row.Field<string>("Channel"))
                           .Where(val => !string.IsNullOrWhiteSpace(val))
                           .Distinct()
                           .ToList()
                : new List<string>();

    var territoryList = dataSet != null
                ? dataSet.AsEnumerable()
                           .Select(row => row.Field<string>("Territory"))
                           .Where(val => !string.IsNullOrWhiteSpace(val))
                           .Distinct()
                           .ToList()
                : new List<string>();

    var areaList = dataSet != null
                ? dataSet.AsEnumerable()
                           .Select(row => row.Field<string>("Area"))
                           .Where(val => !string.IsNullOrWhiteSpace(val))
                           .Distinct()
                           .ToList()
                : new List<string>();

    var outletTypeList = dataSet != null
                ? dataSet.AsEnumerable()
                           .Select(row => row.Field<string>("Outlet_Type")) // Adjust column name if needed (e.g., "Outlet Type")
                           .Where(val => !string.IsNullOrWhiteSpace(val))
                           .Distinct()
                           .ToList()
                : new List<string>();

    var siteCodeList = dataSet != null
                ? dataSet.AsEnumerable()
                           .Select(row => row.Field<string>("Site_Code")) // Adjust column name if needed (e.g., "Site Code")
                           .Where(val => !string.IsNullOrWhiteSpace(val))
                           .Distinct()
                           .ToList()
                : new List<string>();

    var siteNameList = dataSet != null
                ? dataSet.AsEnumerable()
                           .Select(row => row.Field<string>("Site_Name")) // Adjust column name if needed (e.g., "Site Name")
                           .Where(val => !string.IsNullOrWhiteSpace(val))
                           .Distinct()
                           .ToList()
                : new List<string>();

    var storeGradeList = dataSet != null
                ? dataSet.AsEnumerable()
                           .Select(row => row.Field<string>("Store_Grade")) // Adjust column name if needed (e.g., "Store Grade")
                           .Where(val => !string.IsNullOrWhiteSpace(val))
                           .Distinct()
                           .ToList()
                : new List<string>();

    // Attribute
    var colorList = dataSet != null
                ? dataSet.AsEnumerable()
                           .Select(row => row.Field<string>("Color"))
                           .Where(val => !string.IsNullOrWhiteSpace(val))
                           .Distinct()
                           .ToList()
                : new List<string>();

    var silhouetteList = dataSet != null
                ? dataSet.AsEnumerable()
                           .Select(row => row.Field<string>("Silhouette"))
                           .Where(val => !string.IsNullOrWhiteSpace(val))
                           .Distinct()
                           .ToList()
                : new List<string>();

    var collectionAttriList = dataSet != null
                ? dataSet.AsEnumerable()
                           .Select(row => row.Field<string>("Collection")) // Adjust column name if database uses spaces or a different name (e.g., "Collection_Attri")
                           .Where(val => !string.IsNullOrWhiteSpace(val))
                           .Distinct()
                           .ToList()
                : new List<string>();

    var fitCutList = dataSet != null
                ? dataSet.AsEnumerable()
                           .Select(row => row.Field<string>("Fit_Cut")) // Adjust column name if needed (e.g., "Fit Cut")
                           .Where(val => !string.IsNullOrWhiteSpace(val))
                           .Distinct()
                           .ToList()
                : new List<string>();

    var materialCompositionList = dataSet != null
                ? dataSet.AsEnumerable()
                           .Select(row => row.Field<string>("Material_Composition")) // Adjust column name if needed (e.g., "Material Composition")
                           .Where(val => !string.IsNullOrWhiteSpace(val))
                           .Distinct()
                           .ToList()
                : new List<string>();

    var materialConstructionList = dataSet != null
                ? dataSet.AsEnumerable()
                           .Select(row => row.Field<string>("Material_Construction")) // Adjust column name if needed (e.g., "Material Construction")
                           .Where(val => !string.IsNullOrWhiteSpace(val))
                           .Distinct()
                           .ToList()
                : new List<string>();

    var printTextureList = dataSet != null
                ? dataSet.AsEnumerable()
                           .Select(row => row.Field<string>("PrintTexture")) // Adjust column name if needed (e.g., "Print Texture")
                           .Where(val => !string.IsNullOrWhiteSpace(val))
                           .Distinct()
                           .ToList()
                : new List<string>();

    var productLineList = dataSet != null
                ? dataSet.AsEnumerable()
                           .Select(row => row.Field<string>("Product_Line")) // Adjust column name if needed (e.g., "Product Line")
                           .Where(val => !string.IsNullOrWhiteSpace(val))
                           .Distinct()
                           .ToList()
                : new List<string>();

    var sleeveTypeList = dataSet != null
                ? dataSet.AsEnumerable()
                           .Select(row => row.Field<string>("Sleeve_Type")) // Adjust column name if needed (e.g., "Sleeve Type")
                           .Where(val => !string.IsNullOrWhiteSpace(val))
                           .Distinct()
                           .ToList()
                : new List<string>();

    var styleCollectionList = dataSet != null
                ? dataSet.AsEnumerable()
                           .Select(row => row.Field<string>("Style_Collection")) // Adjust column name if needed (e.g., "Style Collection")
                           .Where(val => !string.IsNullOrWhiteSpace(val))
                           .Distinct()
                           .ToList()
                : new List<string>();

    var subCategoryList = dataSet != null
                ? dataSet.AsEnumerable()
                           .Select(row => row.Field<string>("Sub_Category")) // Adjust column name if needed (e.g., "Sub Category")
                           .Where(val => !string.IsNullOrWhiteSpace(val))
                           .Distinct()
                           .ToList()
                : new List<string>();

    var sizeGroupList = dataSet != null
                ? dataSet.AsEnumerable()
                           .Select(row => row.Field<string>("SizeGroup")) // Adjust column name if needed (e.g., "Size Group")
                           .Where(val => !string.IsNullOrWhiteSpace(val))
                           .Distinct()
                           .ToList()
                : new List<string>();

    var origSrpList = dataSet != null
                ? dataSet.AsEnumerable()
                       .Select(row => row["Orig_SRP"]?.ToString())
                       .Where(val => !string.IsNullOrWhiteSpace(val))
                       .Distinct()
                       .ToList()
                : new List<string>();

    // Required
    string brand = string.Empty;
    string division = string.Empty;
    string department = string.Empty;
    string category = string.Empty;
    string selectedPeriodPlans = string.Empty;
    string selectedCollection = string.Empty;
    // Style
    string selectedStyleCode = string.Empty;
    string selectedStyle = string.Empty;
    // Organization
    string selectedRegion = string.Empty;
    string selectedCountry = string.Empty;
    string selectedChannel = string.Empty;
    string selectedTerritory = string.Empty;
    string selectedArea = string.Empty;
    string selectedOutletType = string.Empty;
    string selectedSiteCode = string.Empty;
    string selectedSiteName = string.Empty;
    string selectedStoreGrade = string.Empty;
    // Attributes
    string selectedColor = string.Empty;
    string selectedSilhouette = string.Empty;
    string selectedCollectionAttri = string.Empty;
    string selectedFitCut = string.Empty;
    string selectedMaterialComposition = string.Empty;
    string selectedMaterialConstruction = string.Empty;
    string selectedPrintTexture = string.Empty;
    string selectedProductLine = string.Empty;
    string selectedSleeveType = string.Empty;
    string selectedStyleCollection = string.Empty;
    string selectedSubCategory = string.Empty;
    string selectedSizeGroup = string.Empty;
    string selectedOrigSrp = string.Empty;

    // Handle clicked button event
    if (IsPost && !string.IsNullOrEmpty(Request.Form["actionButton"]))
    {
        string action = Request.Form["actionButton"];

        
        brand = Request.Form["brand"];
        division = Request.Form["division"];
        department = Request.Form["department"];
        category = Request.Form["category"];
        selectedPeriodPlans = Request.Form["periodplans"];

        #region Multi-Select Dropdowns Processing
        Func<string, string> getSelectedValues = (fieldName) =>
        {
            string[] values = Request.Form.GetValues(fieldName) ?? new string[0];
            if (values.Length > 1) return string.Join(",", values);
            return values.Length == 1 ? values[0] : string.Empty;
        };

        selectedCollection = Request.Form["collection"];

        // Style
        selectedStyleCode = getSelectedValues("stylecode");
        selectedStyle = getSelectedValues("style");

        // Organization Filters
        selectedRegion = getSelectedValues("region");
        selectedCountry = getSelectedValues("country");
        selectedChannel = getSelectedValues("channel");
        selectedTerritory = getSelectedValues("territory");
        selectedArea = getSelectedValues("area");
        selectedOutletType = getSelectedValues("outletType");
        selectedSiteCode = getSelectedValues("siteCode");
        selectedSiteName = getSelectedValues("siteName");
        selectedStoreGrade = getSelectedValues("storeGrade");

        // Attributes Section
        selectedColor = getSelectedValues("color");
        selectedSilhouette = getSelectedValues("silhouette");
        selectedCollectionAttri = getSelectedValues("collectionattri");
        selectedFitCut = getSelectedValues("fitcut");
        selectedMaterialComposition = getSelectedValues("materialcomposition");
        selectedMaterialConstruction = getSelectedValues("materialconstruction");
        selectedPrintTexture = getSelectedValues("printtexture");
        selectedProductLine = getSelectedValues("productline");
        selectedSleeveType = getSelectedValues("sleevetype");
        selectedStyleCollection = getSelectedValues("stylecollection");
        selectedSubCategory = getSelectedValues("subcategory");
        selectedSizeGroup = getSelectedValues("sizegroup");
        selectedOrigSrp = getSelectedValues("origsrp");
        #endregion

        // Text Fields Parsing safely
        string factorRate = Request.Form["factorRate"];
        string plc = Request.Form["plc"];
        string wos = Request.Form["wos"];

        decimal factorRateDeci = decimal.TryParse(factorRate, out var fr) ? fr : 0m;
        decimal plcDeci = decimal.TryParse(plc, out var p) ? p : 0m;
        decimal wosDeci = decimal.TryParse(wos, out var w) ? w : 0m;

        // Validate existence of all mandatory entries upfront
        bool mandatoryFieldsMissing = string.IsNullOrEmpty(brand) ||
                                      string.IsNullOrEmpty(division) ||
                                      string.IsNullOrEmpty(department) ||
                                      string.IsNullOrEmpty(category) ||
                                      string.IsNullOrEmpty(selectedPeriodPlans) ||
                                      string.IsNullOrEmpty(selectedCollection);

        if (action == "Calculate")
        {
            if (mandatoryFieldsMissing)
            {
                errorMessage = "Please fill the required filters.";
            }
            else
            {
                service.GetSizeCurveTable(brand, division, department, category, selectedPeriodPlans)
                       .GetAwaiter()
                       .GetResult();

                var result = service.GetCalculation(brand, division, department, category, selectedCollection, selectedPeriodPlans, wosDeci, plcDeci, factorRateDeci)
                                    .GetAwaiter()
                                    .GetResult();

                // Unlock tabs 2, 3, 4 and Size Curve
                Session["CalculationDone"] = true;
                //justCalculated = true;
            }
        }
        else if (action == "Display")
        {
            if (mandatoryFieldsMissing)
            {
                errorMessage = "Please fill the required filters.";
            }
            else
            {
                // Cleaned positional mapping call directly to service
                (tableHeaders, tableRows) = service.GetOptionGalTable(
                    brand,
                    division,
                    department,
                    category,
                    selectedCollection,
                    selectedPeriodPlans,

                    selectedColor,
                    selectedSilhouette,
                    selectedCollectionAttri,
                    selectedFitCut,
                    selectedMaterialComposition,
                    selectedMaterialConstruction,
                    selectedPrintTexture,
                    selectedProductLine,
                    selectedSleeveType,
                    selectedStyleCollection,
                    selectedSizeGroup,
                    selectedStyleCode,
                    selectedStyle,
                    selectedSubCategory,
                    selectedOrigSrp,
                    selectedSiteCode,
                    selectedRegion,
                    selectedCountry,
                    selectedChannel,
                    selectedTerritory,
                    selectedArea,
                    selectedOutletType,
                    selectedSiteName,
                    selectedStoreGrade,
                    null // tagFilter parameter
                ).GetAwaiter().GetResult();

                // NEW: Keep the table for later postbacks (Calculate, paging, etc.)
                Session["OptionGalHeaders"] = tableHeaders;
                Session["OptionGalRows"] = tableRows;

                Session["Brand"] = brand;
                Session["Division"] = division;
                Session["Category"] = category;
                Session["Department"] = department;
                Session["PeriodPlan"] = selectedPeriodPlans;
                Session["Collection"] = selectedCollection;
            }
        }
        else
        {
            // Clear Button Processing Logic
            // NEW: Remove the saved table
            Session.Remove("OptionGalHeaders");
            Session.Remove("OptionGalRows");
            //Session.Remove("CalculationDone");
        }
    }

    // NEW: Restore the last displayed table if this request didn't build a new one
    if (tableHeaders.Count == 0 && Session["OptionGalHeaders"] != null &&
        Session["Brand"] != null && Session["Division"] != null && Session["Department"] != null
        && Session["PeriodPlan"] != null && Session["Collection"] != null
        )
    {
        tableHeaders = Session["OptionGalHeaders"] as List<string> ?? new List<string>();
        tableRows = Session["OptionGalRows"] as List<string[]> ?? new List<string[]>();

        brand = Session["Brand"] as string;
        division = Session["Division"] as string;
        category = Session["Category"] as string;
        department = Session["Department"] as string;
        selectedPeriodPlans = Session["PeriodPlan"] as string;
        //selectedCollection = Session["Collection"] as List<string> ?? new List<string>();
    }

    var headerCssVersion = System.IO.File.GetLastWriteTime(Server.MapPath("~/Pages/Style/header.css")).Ticks.ToString();
    var sectionheaderCss = System.IO.File.GetLastWriteTime(Server.MapPath("~/Pages/Style/sectionheader.css")).Ticks.ToString();
    var buttonCss = System.IO.File.GetLastWriteTime(Server.MapPath("~/Pages/Style/button.css")).Ticks.ToString();

    //var tablePCss = System.IO.File.GetLastWriteTime(Server.MapPath("~/Pages/Style/table-with-pagination.css")).Ticks.ToString();

    var tableIPCss = System.IO.File.GetLastWriteTime(Server.MapPath("~/Pages/Style/table-with-pagination.css")).Ticks.ToString();

    var textfieldCss = System.IO.File.GetLastWriteTime(Server.MapPath("~/Pages/Style/textfield.css")).Ticks.ToString();
    var setfilterswindow = System.IO.File.GetLastWriteTime(Server.MapPath("~/Pages/Style/set-filters-window.css")).Ticks.ToString();
}

<head>
    <link href="~/Pages/Style/header.css?v=@headerCssVersion" rel="stylesheet" />
    <link href="~/Pages/Style/sectionheader.css?v=@sectionheaderCss" rel="stylesheet" />
    <link href="~/Pages/Style/button.css?v=@buttonCss" rel="stylesheet" />

    <!--<link href="~/Pages/Style/table-with-pagination.css?v=tablePCss" rel="stylesheet" />-->

    <link href="~/Pages/Style/table-with-image-and-pagination.css?v=@tableIPCss" rel="stylesheet" />

    <link href="~/Pages/Style/textfield.css?v=@textfieldCss" rel="stylesheet" />
    <link href="~/Pages/Style/set-filters-window.css?v=@setfilterswindow" rel="stylesheet" />
</head>
<body>
    <header role="banner">
        @RenderPage("~/Pages/Common/Header.cshtml", "Step 1: Filters Window")
    </header>

    <main class="main-content-wrapper" role="main">
        <section class="dashboard-container">

            <!-- LEFT SIDEBAR: FILTERS PANEL -->
            <aside class="filter-panel" aria-label="Filters Panel">
                <div class="row">
                    @RenderPage("~/Pages/Common/SectionHeader.cshtml", "Filters")

                    <div class="two-row">
                        <!-- SINGLE FORM WRAPPING ALL INPUTS AND BUTTONS -->
                        <form method="post">
                            <div class="row">
                                <div class="two-col">
                                    <div class="col">
                                        <div class="filter-group">
                                            @RenderPage("~/Pages/Common/SectionHeader.cshtml", "Required Filters*")
                                            @RenderPage("~/Pages/Common/Dropdown.cshtml", "brand", "Brand", brandList, brand, "", "100%")
                                            @RenderPage("~/Pages/Common/Dropdown.cshtml", "division", "Division", divisionList, division, "", "100%")
                                            @RenderPage("~/Pages/Common/Dropdown.cshtml", "department", "Department", departmentList, department, "", "100%")
                                            @RenderPage("~/Pages/Common/Dropdown.cshtml", "category", "Category", categoryList, category, "", "100%")

                                            <!-- Passes selectedPeriodPlans back so selection persists -->
                                            @RenderPage("~/Pages/Common/Dropdown.cshtml", "periodplans", "Period Plan", periodPlanList, selectedPeriodPlans, "", "100%")

                                            @RenderPage("~/Pages/Common/DropdownMultipleSelect.cshtml", "collection", "Collection", collectionList, selectedCollection, "", "100%")
                                        </div>

                                        <div class="filter-group">
                                            @RenderPage("~/Pages/Common/SectionHeader.cshtml", "Styles")
                                            @RenderPage("~/Pages/Common/DropdownMultipleSelect.cshtml", "stylecode", "Style Code", styleCodeList, selectedStyleCode, "", "100%")
                                            @RenderPage("~/Pages/Common/DropdownMultipleSelect.cshtml", "style", "Style", styleList, "", "", "100%")
                                        </div>

                                        <div class="filter-group">
                                            @RenderPage("~/Pages/Common/SectionHeader.cshtml", "Organization")
                                            @RenderPage("~/Pages/Common/DropdownMultipleSelect.cshtml", "region", "Region", regionList, "", "", "100%")
                                            @RenderPage("~/Pages/Common/DropdownMultipleSelect.cshtml", "country", "Country", countryList, "", "", "100%")
                                            @RenderPage("~/Pages/Common/DropdownMultipleSelect.cshtml", "channel", "Channel", channelList, "", "", "100%")
                                            @RenderPage("~/Pages/Common/DropdownMultipleSelect.cshtml", "territory", "Territory", territoryList, "", "", "100%")
                                            @RenderPage("~/Pages/Common/DropdownMultipleSelect.cshtml", "area", "Area", areaList, "", "", "100%")
                                            @RenderPage("~/Pages/Common/DropdownMultipleSelect.cshtml", "outletType", "Outlet Type", outletTypeList, "", "", "100%")
                                            @RenderPage("~/Pages/Common/DropdownMultipleSelect.cshtml", "siteCode", "Site Code", siteCodeList, "", "", "100%")
                                            @RenderPage("~/Pages/Common/DropdownMultipleSelect.cshtml", "siteName", "Site Name", siteNameList, "", "", "100%")
                                            @RenderPage("~/Pages/Common/DropdownMultipleSelect.cshtml", "storeGrade", "Store Grade", storeGradeList, "", "", "100%")
                                        </div>
                                    </div>

                                    <div class="col">
                                        <div class="filter-group">
                                            @RenderPage("~/Pages/Common/SectionHeader.cshtml", "Input Factor Rate")
                                            @RenderPage("~/Pages/Common/TextField.cshtml", "factorRate", "Factor Rate", "1.2", "decimal")
                                        </div>
                                        <div class="filter-group">
                                            @RenderPage("~/Pages/Common/SectionHeader.cshtml", "Input PLC")
                                            @RenderPage("~/Pages/Common/TextField.cshtml", "plc", "PLC", "12", "numeric")
                                        </div>
                                        <div class="filter-group">
                                            @RenderPage("~/Pages/Common/SectionHeader.cshtml", "Input Week of Stock")
                                            @RenderPage("~/Pages/Common/TextField.cshtml", "wos", "WOS", "3", "numeric")
                                        </div>
                                        <div class="filter-group">
                                            @RenderPage("~/Pages/Common/SectionHeader.cshtml", "Attributes")
                                            @RenderPage("~/Pages/Common/DropdownMultipleSelect.cshtml", "color", "Color", colorList, "", "", "100%")
                                            @RenderPage("~/Pages/Common/DropdownMultipleSelect.cshtml", "silhouette", "Silhouette", silhouetteList, "", "", "100%")
                                            @RenderPage("~/Pages/Common/DropdownMultipleSelect.cshtml", "collectionattri", "Collection", collectionAttriList, "", "", "100%")
                                            @RenderPage("~/Pages/Common/DropdownMultipleSelect.cshtml", "fitcut", "Fit Cut", fitCutList, "", "", "100%")
                                            @RenderPage("~/Pages/Common/DropdownMultipleSelect.cshtml", "materialcomposition", "Material Composition", materialCompositionList, "", "", "100%")
                                            @RenderPage("~/Pages/Common/DropdownMultipleSelect.cshtml", "materialconstruction", "Material Construction", materialConstructionList, "", "", "100%")
                                            @RenderPage("~/Pages/Common/DropdownMultipleSelect.cshtml", "printtexture", "PrintTexture", printTextureList, "", "", "100%")
                                            @RenderPage("~/Pages/Common/DropdownMultipleSelect.cshtml", "productline", "Product Line", productLineList, "", "", "100%")
                                            @RenderPage("~/Pages/Common/DropdownMultipleSelect.cshtml", "sleevetype", "Sleeve Type", sleeveTypeList, "", "", "100%")
                                            @RenderPage("~/Pages/Common/DropdownMultipleSelect.cshtml", "stylecollection", "Style Collection", styleCollectionList, "", "", "100%")
                                            @RenderPage("~/Pages/Common/DropdownMultipleSelect.cshtml", "subcategory", "Sub Category", subCategoryList, "", "", "100%")
                                            @RenderPage("~/Pages/Common/DropdownMultipleSelect.cshtml", "sizegroup", "Size Group", sizeGroupList, "", "", "100%")
                                            @RenderPage("~/Pages/Common/DropdownMultipleSelect.cshtml", "origsrp", "Orig SRP", origSrpList, "", "", "100%")
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- BUTTONS MOVED INSIDE THE FORM -->
                            <div class="row">
                                <div class="three-col">
                                    <div class="col">
                                        <!-- UPDATED: now submits so the server can clear the saved table -->
                                        @RenderPage("~/Pages/Common/Button.cshtml", "Clear All", "submit", "actionButton", "Clear")
                                    </div>
                                    <div class="col">
                                        @RenderPage("~/Pages/Common/Button.cshtml", "Display", "submit", "actionButton", "Display")
                                    </div>
                                    <div class="col">
                                        @RenderPage("~/Pages/Common/Button.cshtml", "Calculate", "submit", "actionButton", "Calculate")
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                @if (!string.IsNullOrEmpty(errorMessage))
                                {
                                    <div class="error-message" style="color: #ff4d4d; margin-bottom: 15px; font-weight: 500;">@errorMessage</div>
                                }
                            </div>
                        </form>
                    </div>
                </div>
            </aside>

            <!-- RIGHT SIDEBAR: OPTIONS GALLERY PANEL -->
            <article class="gallery-panel" aria-label="Options Gallery Panel">
                <div class="row">
                    @RenderPage("~/Pages/Common/SectionHeader.cshtml", "Options Gallery")
                    <div class="table-responsive">
                        <!--RenderPage("~/Pages/Common/Table.cshtml", tableHeaders, tableRows)-->
                        <!-- Unchanged: tableHeaders/tableRows are restored from Session in the code block above -->
                        @RenderPage("~/Pages/Common/TableWithImageAndPagination.cshtml", tableHeaders, tableRows, true, 21)
                    </div>
                </div>
            </article>

        </section>
    </main>

    @*
        @if (justCalculated)
        {
            <script>
                // NEW: The tab bar was drawn before Calculate ran, so unlock it in the browser now.
                document.querySelectorAll('.tab-locked').forEach(function (t) {
                    t.classList.remove('tab-locked');
                    t.removeAttribute('aria-disabled');
                    t.removeAttribute('tabindex');
                });
            </script>
