@using System.Data;
@using BuyingTool.Services
@using System.Linq;
@{
    Service service = new Service();

    var tableHeaders = new List<string>();
    var tableRows = new List<string[]>();
    var transposedHeaders = new List<string>();
    var transposedRows = new List<string[]>();
    string errorMessage = string.Empty;

    // Modal state variables
    bool showModal = false;
    string modalTitle = string.Empty;
    string modalBodyContent = string.Empty;

    // Required
    string brand = string.Empty;
    string division = string.Empty;
    string department = string.Empty;
    string category = string.Empty;
    string selectedPeriodPlans = string.Empty;
    string selectedCollection = string.Empty;
    // Style
    string selectedStyleCode = string.Empty;
    string selectedStyle = string.Empty;
    // Organization
    string selectedRegion = string.Empty;
    string selectedCountry = string.Empty;
    string selectedChannel = string.Empty;
    string selectedTerritory = string.Empty;
    string selectedArea = string.Empty;
    string selectedOutletType = string.Empty;
    string selectedSiteCode = string.Empty;
    string selectedSiteName = string.Empty;
    string selectedStoreGrade = string.Empty;
    // Attributes
    string selectedColor = string.Empty;
    string selectedSilhouette = string.Empty;
    string selectedCollectionAttri = string.Empty;
    string selectedFitCut = string.Empty;
    string selectedMaterialComposition = string.Empty;
    string selectedMaterialConstruction = string.Empty;
    string selectedPrintTexture = string.Empty;
    string selectedProductLine = string.Empty;
    string selectedSleeveType = string.Empty;
    string selectedStyleCollection = string.Empty;
    string selectedSubCategory = string.Empty;
    string selectedSizeGroup = string.Empty;
    string selectedOrigSrp = string.Empty;

    // Handle clicked button event
    if (IsPost && !string.IsNullOrEmpty(Request.Form["actionButton"]))
    {
        string action = Request.Form["actionButton"];


        brand = Request.Form["brand"];
        division = Request.Form["division"];
        department = Request.Form["department"];
        category = Request.Form["category"];
        selectedPeriodPlans = Request.Form["periodplans"];

        #region Multi-Select Dropdowns Processing
        Func<string, string> getSelectedValues = (fieldName) =>
        {
            string[] values = Request.Form.GetValues(fieldName) ?? new string[0];
            if (values.Length > 1) return string.Join(",", values);
            return values.Length == 1 ? values[0] : string.Empty;
        };

        selectedCollection = getSelectedValues("collection");

        // Style
        selectedStyleCode = getSelectedValues("stylecode");
        selectedStyle = getSelectedValues("style");

        // Organization Filters
        selectedRegion = getSelectedValues("region");
        selectedCountry = getSelectedValues("country");
        selectedChannel = getSelectedValues("channel");
        selectedTerritory = getSelectedValues("territory");
        selectedArea = getSelectedValues("area");
        selectedOutletType = getSelectedValues("outletType");
        selectedSiteCode = getSelectedValues("siteCode");
        selectedSiteName = getSelectedValues("siteName");
        selectedStoreGrade = getSelectedValues("storeGrade");

        // Attributes Section
        selectedColor = getSelectedValues("color");
        selectedSilhouette = getSelectedValues("silhouette");
        selectedCollectionAttri = getSelectedValues("collectionattri");
        selectedFitCut = getSelectedValues("fitcut");
        selectedMaterialComposition = getSelectedValues("materialcomposition");
        selectedMaterialConstruction = getSelectedValues("materialconstruction");
        selectedPrintTexture = getSelectedValues("printtexture");
        selectedProductLine = getSelectedValues("productline");
        selectedSleeveType = getSelectedValues("sleevetype");
        selectedStyleCollection = getSelectedValues("stylecollection");
        selectedSubCategory = getSelectedValues("subcategory");
        selectedSizeGroup = getSelectedValues("sizegroup");
        selectedOrigSrp = getSelectedValues("origsrp");
        #endregion

        // Text Fields Parsing safely
        string factorRate = Request.Form["factorRate"];
        string plc = Request.Form["plc"];
        string wos = Request.Form["wos"];

        decimal factorRateDeci = decimal.TryParse(factorRate, out var fr) ? fr : 0m;
        decimal plcDeci = decimal.TryParse(plc, out var p) ? p : 0m;
        decimal wosDeci = decimal.TryParse(wos, out var w) ? w : 0m;

        // Validate existence of all mandatory entries upfront
        bool mandatoryFieldsMissing = string.IsNullOrEmpty(brand) ||
                                      string.IsNullOrEmpty(division) ||
                                      string.IsNullOrEmpty(department) ||
                                      string.IsNullOrEmpty(category) ||
                                      string.IsNullOrEmpty(selectedPeriodPlans) ||
                                      string.IsNullOrEmpty(selectedCollection);

        if (action == "Calculate")
        {
            if (mandatoryFieldsMissing)
            {
                errorMessage = "Please fill the required filters.";

                showModal = true;
                modalTitle = "Processing Error";
                modalBodyContent = errorMessage;
            }
            else
            {
                (tableHeaders, tableRows) = service.GetOptionGalTable(
                   brand,
                   division,
                   department,
                   category,
                   selectedCollection,
                   selectedPeriodPlans,

                   selectedColor,
                   selectedSilhouette,
                   selectedCollectionAttri,
                   selectedFitCut,
                   selectedMaterialComposition,
                   selectedMaterialConstruction,
                   selectedPrintTexture,
                   selectedProductLine,
                   selectedSleeveType,
                   selectedStyleCollection,
                   selectedSizeGroup,
                   selectedStyleCode,
                   selectedStyle,
                   selectedSubCategory,
                   selectedOrigSrp,
                   selectedSiteCode,
                   selectedRegion,
                   selectedCountry,
                   selectedChannel,
                   selectedTerritory,
                   selectedArea,
                   selectedOutletType,
                   selectedSiteName,
                   selectedStoreGrade,
                   null // tagFilter parameter
               ).GetAwaiter().GetResult();

                (transposedHeaders, transposedRows) = service.TransposeTable(tableHeaders, tableRows).GetAwaiter().GetResult();

                // NEW: Keep the table for later postbacks (Calculate, paging, etc.)
                Session["OptionGalHeaders"] = transposedHeaders;
                Session["OptionGalRows"] = transposedRows;

                service.GetSizeCurveTable(brand, division, department, category, selectedPeriodPlans)
                       .GetAwaiter()
                       .GetResult();

                var result = service.GetCalculation(brand, division, department, category, selectedCollection, selectedPeriodPlans, wosDeci, plcDeci, factorRateDeci)
                                    .GetAwaiter()
                                    .GetResult();

                // Unlock tabs 2, 3, 4 and Size Curve
                Session["CalculationDone"] = true;
                Session["Brand"] = brand;
                Session["Division"] = division;
                Session["Category"] = category;
                Session["Department"] = department;
                Session["PeriodPlan"] = selectedPeriodPlans;
                Session["Collection"] = selectedCollection;

                Session["Style"] = selectedStyle;
                Session["StyleCode"] = selectedStyleCode;

                Session["Region"] = selectedRegion;
                Session["Country"] = selectedCountry;
                Session["Channel"] = selectedChannel;
                Session["Territory"] = selectedTerritory;
                Session["Area"] = selectedArea;
                Session["OutletType"] = selectedOutletType;
                Session["SiteCode"] = selectedSiteCode;
                Session["SiteName"] = selectedSiteName;
                Session["StoreGrade"] = selectedStoreGrade;

                Session["Color"] = selectedColor;
                Session["Silhouette"] = selectedSilhouette;
                Session["CollectionAttri"] = selectedCollectionAttri;
                Session["FitCut"] = selectedFitCut;
                Session["MaterialComposition"] = selectedMaterialComposition;
                Session["MaterialConstruction"] = selectedMaterialConstruction;
                Session["PrintTexture"] = selectedPrintTexture;
                Session["ProductLine"] = selectedProductLine;
                Session["SleeveType"] = selectedSleeveType;
                Session["StyleCollection"] = selectedStyleCollection;
                Session["SubCategory"] = selectedSubCategory;
                Session["SizeGroup"] = selectedSizeGroup;
                Session["OrigSrp"] = selectedOrigSrp;

                Response.Redirect("~/?tab=2.%20Review%20Summary");
            }
        }
        else if (action == "Display")
        {
            if (mandatoryFieldsMissing)
            {
                errorMessage = "Please fill the required filters.";

                showModal = true;
                modalTitle = "Processing Error";
                modalBodyContent = errorMessage;
            }
            else
            {
                // Cleaned positional mapping call directly to service
                (tableHeaders, tableRows) = service.GetOptionGalTable(
                    brand,
                    division,
                    department,
                    category,
                    selectedCollection,
                    selectedPeriodPlans,

                    selectedColor,
                    selectedSilhouette,
                    selectedCollectionAttri,
                    selectedFitCut,
                    selectedMaterialComposition,
                    selectedMaterialConstruction,
                    selectedPrintTexture,
                    selectedProductLine,
                    selectedSleeveType,
                    selectedStyleCollection,
                    selectedSizeGroup,
                    selectedStyleCode,
                    selectedStyle,
                    selectedSubCategory,
                    selectedOrigSrp,
                    selectedSiteCode,
                    selectedRegion,
                    selectedCountry,
                    selectedChannel,
                    selectedTerritory,
                    selectedArea,
                    selectedOutletType,
                    selectedSiteName,
                    selectedStoreGrade,
                    null // tagFilter parameter
                ).GetAwaiter().GetResult();

                (transposedHeaders, transposedRows) = service.TransposeTable(tableHeaders, tableRows).GetAwaiter().GetResult();

                // NEW: Keep the table for later postbacks (Calculate, paging, etc.)
                Session["OptionGalHeaders"] = transposedHeaders;
                Session["OptionGalRows"] = transposedRows;

                Session["Brand"] = brand;
                Session["Division"] = division;
                Session["Category"] = category;
                Session["Department"] = department;
                Session["PeriodPlan"] = selectedPeriodPlans;
                Session["Collection"] = selectedCollection;

                Session["Style"] = selectedStyle;
                Session["StyleCode"] = selectedStyleCode;

                Session["Region"] = selectedRegion;
                Session["Country"] = selectedCountry;
                Session["Channel"] = selectedChannel;
                Session["Territory"] = selectedTerritory;
                Session["Area"] = selectedArea;
                Session["OutletType"] = selectedOutletType;
                Session["SiteCode"] = selectedSiteCode;
                Session["SiteName"] = selectedSiteName;
                Session["StoreGrade"] = selectedStoreGrade;

                Session["Color"] = selectedColor ;
                Session["Silhouette"] = selectedSilhouette ;
                Session["CollectionAttri"] = selectedCollectionAttri ;
                Session["FitCut"] = selectedFitCut;
                Session["MaterialComposition"] = selectedMaterialComposition;
                Session["MaterialConstruction"] = selectedMaterialConstruction;
                Session["PrintTexture"] = selectedPrintTexture;
                Session["ProductLine"] = selectedProductLine;
                Session["SleeveType"] = selectedSleeveType;
                Session["StyleCollection"] = selectedStyleCollection;
                Session["SubCategory"] = selectedSubCategory;
                Session["SizeGroup"] = selectedSizeGroup;
                Session["OrigSrp"] = selectedOrigSrp;
            }
        }
        else
        {
            // Clear Button Processing Logic
            // NEW: Remove the saved table
            Session.Remove("OptionGalHeaders");
            Session.Remove("OptionGalRows");
            Session.Remove("CalculationDone");

            Session.Remove("Brand");
            Session.Remove("Division");
            Session.Remove("Category");
            Session.Remove("Department");
            Session.Remove("PeriodPlan");
            Session.Remove("Collection");

            Session.Remove("Style");
            Session.Remove("StyleCode");

            Session.Remove("Region");
            Session.Remove("Country");
            Session.Remove("Channel");
            Session.Remove("Territory");
            Session.Remove("Area");
            Session.Remove("OutletType");
            Session.Remove("SiteCode");
            Session.Remove("SiteName");
            Session.Remove("StoreGrade");

            Session.Remove("Color");
            Session.Remove("Silhouette");
            Session.Remove("CollectionAttri");
            Session.Remove("FitCut");
            Session.Remove("MaterialComposition");
            Session.Remove("MaterialConstruction");
            Session.Remove("PrintTexture");
            Session.Remove("ProductLine");
            Session.Remove("SleeveType");
            Session.Remove("StyleCollection");
            Session.Remove("SubCategory");
            Session.Remove("SizeGroup");
            Session.Remove("OrigSrp");

        }
    }

    // NEW: Restore the last displayed table if this request didn't build a new one
    if (transposedHeaders.Count == 0 && Session["OptionGalHeaders"] != null &&
        Session["Brand"] != null && Session["Division"] != null && Session["Department"] != null
        && Session["PeriodPlan"] != null && Session["Collection"] != null
        )
    {
        transposedHeaders = Session["OptionGalHeaders"] as List<string> ?? new List<string>();
        transposedRows = Session["OptionGalRows"] as List<string[]> ?? new List<string[]>();

        brand = Session["Brand"] as string;
        division = Session["Division"] as string;
        category = Session["Category"] as string;
        department = Session["Department"] as string;
        selectedPeriodPlans = Session["PeriodPlan"] as string;
        //selectedCollection = Session["Collection"] as List<string> ?? new List<string>();
    }


    var modalFooter = "<button type='button' class='button' onclick=\"closeModal('allocResultModal')\">OK</button>";
    // Server-side check: Forces display to flex if showModal is true, otherwise hidden
    string modalStyle = showModal ? "position: fixed !important; top: 0 !important; left: 0 !important; width: 100vw !important; height: 100vh !important; background-color: rgba(0, 0, 0, 0.6) !important; display: flex !important; justify-content: center !important; align-items: center !important; z-index: 99999 !important;" : "display: none !important;";


    var headerCssVersion = System.IO.File.GetLastWriteTime(Server.MapPath("~/Pages/Style/header.css")).Ticks.ToString();
    var sectionheaderCss = System.IO.File.GetLastWriteTime(Server.MapPath("~/Pages/Style/sectionheader.css")).Ticks.ToString();
    var buttonCss = System.IO.File.GetLastWriteTime(Server.MapPath("~/Pages/Style/button.css")).Ticks.ToString();

    //var tablePCss = System.IO.File.GetLastWriteTime(Server.MapPath("~/Pages/Style/table-with-pagination.css")).Ticks.ToString();

    var tableIPCss = System.IO.File.GetLastWriteTime(Server.MapPath("~/Pages/Style/table-with-pagination.css")).Ticks.ToString();

    var textfieldCss = System.IO.File.GetLastWriteTime(Server.MapPath("~/Pages/Style/textfield.css")).Ticks.ToString();
    var setfilterswindow = System.IO.File.GetLastWriteTime(Server.MapPath("~/Pages/Style/set-filters-window.css")).Ticks.ToString();

    var modalJsVersion = System.IO.File.GetLastWriteTime(Server.MapPath("~/Pages/Scripts/modal.js")).Ticks.ToString();
}

<head>
    <link href="~/Pages/Style/header.css?v=@headerCssVersion" rel="stylesheet" />
    <link href="~/Pages/Style/sectionheader.css?v=@sectionheaderCss" rel="stylesheet" />
    <link href="~/Pages/Style/button.css?v=@buttonCss" rel="stylesheet" />

    <!--<link href="~/Pages/Style/table-with-pagination.css?v=tablePCss" rel="stylesheet" />-->

    <link href="~/Pages/Style/table-with-image-and-pagination.css?v=@tableIPCss" rel="stylesheet" />

    <link href="~/Pages/Style/textfield.css?v=@textfieldCss" rel="stylesheet" />
    <link href="~/Pages/Style/set-filters-window.css?v=@setfilterswindow" rel="stylesheet" />

    <script src="~/Pages/Scripts/modal.js?v=@modalJsVersion"></script>
</head>
<body>
    <header role="banner">
        @RenderPage("~/Pages/Common/Header.cshtml", "Step 1: Filters Window")
    </header>

    <main class="main-content-wrapper" role="main">
        <section class="dashboard-container">

            <!-- LEFT SIDEBAR: FILTERS PANEL -->
            <aside class="filter-panel" aria-label="Filters Panel">
                <div class="row">
                    @RenderPage("~/Pages/Common/SectionHeader.cshtml", "Filters")

                    <div class="two-row">
                        <!-- SINGLE FORM WRAPPING ALL INPUTS AND BUTTONS -->
                        <form method="post">
                            <div class="row">
                                <div class="two-col">
                                    <div class="col">
                                        <div class="filter-group">
                                            @RenderPage("~/Pages/Common/SectionHeader.cshtml", "Required Filters*")
                                            @RenderPage("~/Pages/Common/Dropdown.cshtml", "brand", "Brand", new List<string>(), brand, "", "100%", "changeFilter(dd_brand)")
                                            @RenderPage("~/Pages/Common/Dropdown.cshtml", "division", "Division", new List<string>(), division, "", "100%", "changeFilter(dd_division)")
                                            @RenderPage("~/Pages/Common/Dropdown.cshtml", "department", "Department", new List<string>(), department, "", "100%", "changeFilter(dd_department)")
                                            @RenderPage("~/Pages/Common/Dropdown.cshtml", "category", "Category", new List<string>(), category, "", "100%", "changeFilter(dd_category)")

                                            <!-- Passes selectedPeriodPlans back so selection persists -->
                                            @RenderPage("~/Pages/Common/Dropdown.cshtml", "periodplans", "Period Plan", new List<string>(), selectedPeriodPlans, "", "100%", "changeFilter(dd_periodplans)")

                                            @RenderPage("~/Pages/Common/DropdownMultipleSelect.cshtml", "collection", "Collection", new List<string>(), selectedCollection, "", "100%", "changeFilter(dd_collection)")
                                            
                                        </div>

                                        <div class="filter-group">
                                            @RenderPage("~/Pages/Common/SectionHeader.cshtml", "Styles")
                                            @RenderPage("~/Pages/Common/DropdownMultipleSelect.cshtml", "stylecode", "Style Code", new List<string>(), selectedStyleCode, "", "100%", "changeStyle(dd_stylecode)")
                                            @RenderPage("~/Pages/Common/DropdownMultipleSelect.cshtml", "style", "Style", new List<string>(), "", "", "100%", "changeStyle(dd_style)")
                                        </div>

                                        <div class="filter-group">
                                            @RenderPage("~/Pages/Common/SectionHeader.cshtml", "Organization")
                                            @RenderPage("~/Pages/Common/DropdownMultipleSelect.cshtml", "region", "Region", new List<string>(), "", "", "100%", "changeFilter(dd_region)")
                                            @RenderPage("~/Pages/Common/DropdownMultipleSelect.cshtml", "country", "Country", new List<string>(), "", "", "100%", "changeFilter(dd_country)")
                                            @RenderPage("~/Pages/Common/DropdownMultipleSelect.cshtml", "channel", "Channel", new List<string>(), "", "", "100%", "changeFilter(dd_channel)")
                                            @RenderPage("~/Pages/Common/DropdownMultipleSelect.cshtml", "territory", "Territory", new List<string>(), "", "", "100%", "changeFilter(dd_territory)")
                                            @RenderPage("~/Pages/Common/DropdownMultipleSelect.cshtml", "area", "Area", new List<string>(), "", "", "100%", "changeFilter(dd_area)")
                                            @RenderPage("~/Pages/Common/DropdownMultipleSelect.cshtml", "outletType", "Outlet Type", new List<string>(), "", "", "100%", "changeFilter(dd_outletType)")
                                            @RenderPage("~/Pages/Common/DropdownMultipleSelect.cshtml", "siteCode", "Site Code", new List<string>(), "", "", "100%", "changeFilter(dd_siteCode)")
                                            @RenderPage("~/Pages/Common/DropdownMultipleSelect.cshtml", "siteName", "Site Name", new List<string>(), "", "", "100%", "changeFilter(dd_siteName)")
                                            @RenderPage("~/Pages/Common/DropdownMultipleSelect.cshtml", "storeGrade", "Store Grade", new List<string>(), "", "", "100%", "changeFilter(dd_storeGrade)")
                                        </div>
                                    </div>

                                    <div class="col">
                                        <div class="filter-group">
                                            @RenderPage("~/Pages/Common/SectionHeader.cshtml", "Input Factor Rate")
                                            @RenderPage("~/Pages/Common/TextField.cshtml", "factorRate", "Factor Rate", "1.2", "decimal")
                                        </div>
                                        <div class="filter-group">
                                            @RenderPage("~/Pages/Common/SectionHeader.cshtml", "Input PLC")
                                            @RenderPage("~/Pages/Common/TextField.cshtml", "plc", "PLC", "12", "numeric")
                                        </div>
                                        <div class="filter-group">
                                            @RenderPage("~/Pages/Common/SectionHeader.cshtml", "Input Week of Stock")
                                            @RenderPage("~/Pages/Common/TextField.cshtml", "wos", "WOS", "3", "numeric")
                                        </div>
                                        <div class="filter-group">
                                            @RenderPage("~/Pages/Common/SectionHeader.cshtml", "Attributes")
                                            @RenderPage("~/Pages/Common/DropdownMultipleSelect.cshtml", "color", "Color", new List<string>(), "", "", "100%", "changeStyle(dd_color)")
                                            @RenderPage("~/Pages/Common/DropdownMultipleSelect.cshtml", "silhouette", "Silhouette", new List<string>(), "", "", "100%", "changeStyle(dd_silhouette)")
                                            @RenderPage("~/Pages/Common/DropdownMultipleSelect.cshtml", "collectionattri", "Collection", new List<string>(), "", "", "100%", "changeStyle(dd_collectionattri)")
                                            @RenderPage("~/Pages/Common/DropdownMultipleSelect.cshtml", "fitcut", "Fit Cut", new List<string>(), "", "", "100%", "changeStyle(dd_fitcut)")
                                            @RenderPage("~/Pages/Common/DropdownMultipleSelect.cshtml", "materialcomposition", "Material Composition", new List<string>(), "", "", "100%", "changeStyle(dd_materialcomposition)")
                                            @RenderPage("~/Pages/Common/DropdownMultipleSelect.cshtml", "materialconstruction", "Material Construction", new List<string>(), "", "", "100%", "changeStyle(dd_materialconstruction)")
                                            @RenderPage("~/Pages/Common/DropdownMultipleSelect.cshtml", "printtexture", "Print Texture", new List<string>(), "", "", "100%", "changeStyle(dd_printtexture)")
                                            @RenderPage("~/Pages/Common/DropdownMultipleSelect.cshtml", "productline", "Product Line", new List<string>(), "", "", "100%", "changeStyle(dd_productline)")
                                            @RenderPage("~/Pages/Common/DropdownMultipleSelect.cshtml", "sleevetype", "Sleeve Type", new List<string>(), "", "", "100%", "changeStyle(dd_sleevetype)")
                                            @RenderPage("~/Pages/Common/DropdownMultipleSelect.cshtml", "stylecollection", "Style Collection", new List<string>(), "", "", "100%", "changeStyle(dd_stylecollection)")
                                            @RenderPage("~/Pages/Common/DropdownMultipleSelect.cshtml", "subcategory", "Sub Category", new List<string>(), "", "", "100%", "changeStyle(dd_subcategory)")
                                            @RenderPage("~/Pages/Common/DropdownMultipleSelect.cshtml", "sizegroup", "Size Group", new List<string>(), "", "", "100%", "changeStyle(dd_sizegroup)")
                                            @RenderPage("~/Pages/Common/DropdownMultipleSelect.cshtml", "origsrp", "Orig SRP", new List<string>(), "", "", "100%", "changeStyle(dd_origsrp)")
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- BUTTONS MOVED INSIDE THE FORM -->
                            <div class="row">
                                <div class="three-col">
                                    <div class="col">
                                        <!-- UPDATED: now submits so the server can clear the saved table -->
                                        @RenderPage("~/Pages/Common/Button.cshtml", "Clear All", "submit", "actionButton", "Clear")
                                    </div>
                                    <div class="col">
                                        @RenderPage("~/Pages/Common/Button.cshtml", "Display", "submit", "actionButton", "Display")
                                    </div>
                                    <div class="col">
                                        @RenderPage("~/Pages/Common/Button.cshtml", "Calculate", "submit", "actionButton", "Calculate")
                                    </div>
                                </div>
                            </div>

                            <div class="row">

                                <!--Modal-->
                                <div class="modal-backdrop" id="allocResultModal" style="@modalStyle" aria-hidden="@(showModal ? "false" : "true")" onclick="handleBackdropClick(event, 'allocResultModal')">
                                    <div class="modal-dialog" role="dialog" aria-labelledby="allocResultModal-title" aria-modal="true" style="background: #f4f4f4 !important; position: relative !important; z-index: 100000 !important; border-radius: 6px; box-shadow: 0 5px 15px rgba(0,0,0,0.3); max-width: 500px; width: 100%; overflow: hidden;">
                                        <div class="modal-header" style="background: #f4f4f4 !important; padding: 15px 20px; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #ddd;">
                                            <h3 id="allocResultModal-title" class="modal-title" style="margin: 0; font-size: 1.25rem; color: #333;">@modalTitle</h3>
                                            <button type="button" class="modal-close" onclick="closeModal('allocResultModal')" aria-label="Close modal" style="background: transparent; border: none; font-size: 1.5rem; cursor: pointer;">&times;</button>
                                        </div>
                                        <div class="modal-body" style="background: #f4f4f4 !important; padding: 20px; color: #333;">
                                            @Html.Raw(modalBodyContent)
                                        </div>
                                        @if (!string.IsNullOrEmpty(modalFooter))
                                        {
                                            <div class="modal-footer" style="background: #eeeeee !important; padding: 12px 20px; border-top: 1px solid #ddd; display: flex; justify-content: flex-end; gap: 10px;">
                                                @Html.Raw(modalFooter)
                                            </div>
                                        }
                                    </div>
                                </div>

                                <!--
                                 if (!string.IsNullOrEmpty(errorMessage))
                                 {
                                    <div class="error-message" style="color: #ff4d4d; margin-bottom: 15px; font-weight: 500;">errorMessage</div>
                                 }
                                -->
                            </div>
                        </form>
                    </div>
                </div>
            </aside>

            <!-- RIGHT SIDEBAR: OPTIONS GALLERY PANEL -->
            <article class="gallery-panel" aria-label="Options Gallery Panel">
                <div class="row">
                    @RenderPage("~/Pages/Common/SectionHeader.cshtml", "Options Gallery")
                    <div class="table-responsive">
                        <!-- Unchanged: tableHeaders/tableRows are restored from Session in the code block above -->
                        <!---RenderPage("~/Pages/Common/TableWithImageAndPagination.cshtml", tableHeaders, tableRows, true, 21)-->

                        @RenderPage("~/Pages/Common/TableWithImageAndPagination.cshtml", transposedHeaders, transposedRows, true, 10)

                    </div>
                </div>
            </article>

        </section>
    </main>

</body>
<script src="~/Pages/Scripts/SetFilters.js"></script>