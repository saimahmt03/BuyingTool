@using System.Collections.Generic
@using System.Linq
@{
    // How to call for multi-select:
    // @RenderPage("~/Pages/Component/Dropdown.cshtml", name, label, options, selectedValues, style, labelWidth)

    var name = PageData[0] as string;
    var label = PageData[1] as string;
    var options = PageData[2] as IEnumerable<string>;

    var selectedRaw = PageData[3];
    IEnumerable<string> selectedValues = selectedRaw as IEnumerable<string>
        ?? (selectedRaw is string strVal ? strVal.Split(new[] { ',' }, StringSplitOptions.RemoveEmptyEntries).Select(s => s.Trim()) : Enumerable.Empty<string>());

    var style = PageData[4] as string;
    var labelWidth = PageData[5] as string;
    var onChangeAction = PageData.Count > 6 ? PageData[6] as string : "";

    if (options == null) { options = new string[0]; }
    if (string.IsNullOrEmpty(labelWidth)) { labelWidth = "80px"; }

    var hasValue = selectedValues.Any();

    var css = "dropdown dropdown--multi";
    if (style == "plain") { css += " dropdown--plain"; }
    else if (hasValue) { css += " dropdown--selected"; }
    else { css += " dropdown--empty"; }

    if (style == "bar") { css += " dropdown--bar"; }

    var id = "dd_" + name;
}

<div class="@css" style="--dd-label-width:@labelWidth">
    <label class="dropdown__label" for="@id">@label</label>
    <span class="dropdown__arrow" aria-hidden="true"></span>
    <select class="dropdown__select"
            id="@id"
            name="@name"
            multiple
            size="1"
            onfocus="this.size=5;"
            onblur="this.size=1;"
            onchange="this.size=1; this.blur(); @onChangeAction">
        <option value="" selected="@(!hasValue)">-- Select --</option>
        @foreach (var o in options)
        {
            var isSelected = selectedValues.Contains(o);
            <option value="@o" selected="@isSelected">@o</option>
        }
    </select>
</div>