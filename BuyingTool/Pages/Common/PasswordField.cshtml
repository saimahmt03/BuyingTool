@{
    // How to call:
    //    @RenderPage("~/Pages/Component/Passwordfield.cshtml", name, label, value)
    //
    //    name  : form field name
    //    label : text on the left
    //    value : current value

    var name = PageData[0] as string;
    var label = PageData[1] as string;
    var value = PageData[2] as string;

    var id = "pf_" + name;
}

<div class="textfield textfield--password">
    <label class="textfield__label" for="@id">@label</label>
    <input class="textfield__input"
           type="password" id="@id"
           name="@name"
           value="@value"
           autocomplete="current-password" />
</div>
