@{
    // How to call:
    //   @RenderPage("~/Pages/Component/Textfield.cshtml", name, label, value, inputMode)
    //
    //   name      : form field name
    //   label     : text on the left
    //   value     : current value
    //   inputMode : "decimal" | "numeric" | "text" (picks the phone keyboard)

    var name = PageData[0] as string;
    var label = PageData[1] as string;
    var value = PageData[2] as string;
    var inputMode = PageData[3] as string;

    if (string.IsNullOrEmpty(inputMode)) { inputMode = "text"; }

    var id = "tf_" + name;

    var inputType = (inputMode == "decimal" || inputMode == "numeric") ? "text" : "text";
}

<div class="textfield">
    <label class="textfield__label" for="@id">@label</label>
    <input class="textfield__input" 
           type="text" id="@id" 
           name="@name" 
           value="@value" 
           inputmode="@inputMode" 
           @if(inputMode == "decimal") { <text>step="any"</text> }
           autocomplete="off" />
</div>