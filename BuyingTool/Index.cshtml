            @RenderPage("~/Pages/Component/SetFiltersWindow.cshtml", activeTab)
        </section>
    }
    else if (activeTab == "2. Review Summary")
    {
        <section id="tab-2.-review-summary" class="tab-pane" aria-label="Review Summary">
            @RenderPage("~/Pages/Component/ReviewSummary.cshtml", activeTab)
        </section>

        @*if (isCalculated)
        {
            <section id="tab-2.-review-summary" class="tab-pane" aria-label="Review Summary">
                @RenderPage("~/Pages/Component/ReviewSummary.cshtml", activeTab)
            </section>
        }
        else
        {
            <div class="alert alert-warning" role="alert">
                Please click the *Calculate* button first to unlock the Review Summary.
            </div>
        }*@
    }
    else if (activeTab == "3. Review Site Details")
    {
        <section id="tab-3.-review-site-details" class="tab-pane" aria-label="Review Site Details">
            @RenderPage("~/Pages/Component/ReviewSiteDetails.cshtml", activeTab)
        </section>
    }
    else if (activeTab == "4. Export")
    {
        <section id="tab-4.-export" class="tab-pane" aria-label="Export">
            @RenderPage("~/Pages/Component/Export.cshtml", activeTab)
        </section>
    }
    else if (activeTab == "Size Curve")
    {
        <section id="tab-size-curve" class="tab-pane" aria-label="Size Curve">
            @RenderPage("~/Pages/Component/SizeCurve.cshtml", activeTab)
        </section>
    }
    else if (activeTab == "Monitoring")
    {
        <section id="tab-size-curve" class="tab-pane" aria-label="Size Curve">
            @RenderPage("~/Pages/Component/Monitoring.cshtml", activeTab)
        </section>
    }
</main>

